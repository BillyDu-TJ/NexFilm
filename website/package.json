{
  "name": "nexfilm-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile:handbook": "node ../scripts/compile-handbook.mjs",
    "sync:workspace": "node scripts/sync-workspace-demo.mjs",
    "predev": "npm run compile:handbook && node scripts/sync-workspace-demo.mjs",
    "dev": "astro dev --host",
    "start": "astro dev",
    "prebuild": "npm run compile:handbook && node scripts/sync-workspace-demo.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "verify:static": "node scripts/verify-static-lint.cjs",
    "test:browser": "npm run build && node scripts/test-browser-integration.cjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.2",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "puppeteer-core": "^25.16.0"
  }
}
