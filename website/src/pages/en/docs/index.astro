---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsSearchModal from '../../../components/DocsSearchModal.astro';
import { withBase } from '../../../utils/urls';
import { getTrackGroups } from '../../../utils/docs';

const lang = 'en';
const groups = await getTrackGroups('en');

const portalCards = [
  {
    track: 'getting-started',
    kicker: '01 / Getting Started',
    title: 'Getting Started & Camera Scanning',
    subtitle: 'For new users and camera digitizers: hardware selection, Gatekeeper authorization, and 5-minute roll inversion.',
    targetSlug: 'overview-and-install',
    badge: '4 Refined Chapters',
    badgeColor: 'text-accent border-accent/30 bg-accent-soft',
    highlights: [
      'Physics-grounded optical density negative inversion',
      'CRI ≥ 95 backlight selection and ETTR exposure rules',
      'The non-negotiable rule of unexposed film base retention',
      'Whole-roll batch processing and shared white point anti-divergence',
    ],
  },
  {
    track: 'user-manual',
    kicker: '02 / User Manual',
    title: 'Complete Workbench User Manual',
    subtitle: 'Comprehensive guide aligned 100% with the actual UI: five core views, film area cropping, curves, and master exports.',
    targetSlug: 'workspace-and-views',
    badge: '7 Feature Chapters',
    badgeColor: 'text-text-secondary border-darkroom-line bg-darkroom-raised',
    highlights: [
      'Workspace region roles and filmstrip navigation',
      'Automatic film area detection and light panel exclusion',
      'Logarithmic Printer Lights additive/subtractive grading',
      '14 built-in Kodak / Ilford darkroom paper LUTs',
    ],
  },
  {
    track: 'color-science',
    kicker: '03 / Color Science',
    title: 'Color Science & Optical Density Whitepapers',
    subtitle: 'For advanced colorists and technicians: rigorous mathematical derivations of transmission, density, and hardware calibration.',
    targetSlug: 'three-mathematical-domains',
    badge: '4 Advanced Whitepapers',
    badgeColor: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/10',
    highlights: [
      'Strict separation between transmittance, density, and output domains',
      'Five-tier input domain resolution and camera matrix isolation',
      'Bounded channel span model (1.15× / 1.35× / 3.0×)',
      'Flat-field transmission normalization & DaVinci linear workflows',
    ],
  },
  {
    track: 'architecture',
    kicker: '04 / Architecture',
    title: 'System Architecture & Contributing',
    subtitle: 'For open-source engineers: Tauri 2 runtime model, WebGL2 fragment shaders, and Rust CPU rendering parity.',
    targetSlug: 'system-architecture',
    badge: '3 Architecture Guides',
    badgeColor: 'text-sky-400 border-sky-400/30 bg-sky-400/10',
    highlights: [
      'Zero full-resolution RAW decoding on import with on-demand 16-bit proxies',
      'GPU WebGL2 and Rust CPU full-resolution export WYSIWYG contract',
      'Cross-platform LibRaw and Rawler dual-backend orchestration',
      'Automated regression contract suites and pull request guidelines',
    ],
  },
];

const quickTasks = [
  {
    title: 'High-CRI Backlight & ETTR Exposure Rules',
    category: 'Digitization',
    path: '/en/docs/scanning-best-practices/#optical-illumination',
  },
  {
    title: 'Five Minutes to Your First Inverted Roll',
    category: 'Practical Guide',
    path: '/en/docs/first-roll-in-five-minutes/#import-workflow',
  },
  {
    title: 'Excluding Light Panels to Prevent Muddy Tones',
    category: 'Film Area',
    path: '/en/docs/first-roll-in-five-minutes/#film-area-definition',
  },
  {
    title: 'Whole-Roll Shared White Point Anti-Divergence',
    category: 'Roll Consistency',
    path: '/en/docs/roll-vs-loose-workflows/#whole-roll-batch-processing',
  },
  {
    title: '120 Format & Headless Bounded Span Fallback',
    category: 'Channel Span',
    path: '/en/docs/roll-vs-loose-workflows/#120-and-headless-fallback',
  },
  {
    title: 'Tone Curves & 9 Universal Shortcuts',
    category: 'Workbench',
    path: '/en/docs/density-grading-and-curves/#curve-and-detail',
  },
];
---

<BaseLayout
  title="Documentation & Technical Reference · NexFilm Engine"
  description="NexFilm Engine documentation hub: from optical scanning standards and five-minute quick start to workbench manuals and optical density color science."
  lang={lang}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-16">
    
    <!-- Hero Header -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-soft border border-accent/30 text-accent text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>NexFilm SSOT Documentation Hub</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-text-primary font-sans">
        Scientific, Verifiable &amp; Physics-Grounded<br />
        <span class="text-accent">Film Inversion Technical Manual</span>
      </h1>
      <p class="text-base sm:text-lg text-text-secondary leading-relaxed font-sans">
        No marketing fluff or hollow outlines. NexFilm documentation strictly aligns with the real user interface and optical physics, guiding you from digitization to master delivery.
      </p>

      <!-- Quick Search Trigger in Hero -->
      <div class="pt-2 max-w-md mx-auto">
        <button
          type="button"
          class="doc-search-trigger w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-darkroom-panel border border-darkroom-line hover:border-accent text-text-muted hover:text-text-secondary text-sm transition-all shadow-darkroom-card group"
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Quick search documentation &amp; whitepapers...</span>
          </div>
          <kbd class="px-2 py-0.5 text-xs font-mono bg-darkroom-raised rounded-lg border border-darkroom-line text-text-muted group-hover:border-accent/40 group-hover:text-accent transition-colors">⌘K</kbd>
        </button>
      </div>
    </header>

    <!-- Quick Task Navigator (6 High-Frequency Jump Points) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-darkroom-line pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <h2 class="text-sm font-mono font-bold tracking-wider uppercase text-text-primary">Core Task Quick Access</h2>
        </div>
        <span class="text-xs text-text-muted font-mono">Quick Access</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {quickTasks.map((task) => (
          <a
            href={withBase(task.path)}
            class="group p-3.5 rounded-xl bg-darkroom-panel border border-darkroom-line hover:border-accent/60 transition-all flex items-center justify-between"
          >
            <div class="space-y-0.5 min-w-0 pr-2">
              <span class="text-[10px] font-mono text-accent block uppercase tracking-wider">{task.category}</span>
              <span class="text-xs font-medium text-text-primary group-hover:text-accent transition-colors truncate block">
                {task.title}
              </span>
            </div>
            <svg class="w-4 h-4 text-text-muted group-hover:text-accent group-hover:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Four Track Audience Cards -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-darkroom-line pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <h2 class="text-sm font-mono font-bold tracking-wider uppercase text-text-primary">Four Pillar Architecture</h2>
        </div>
        <span class="text-xs text-text-muted font-mono">Four Core Pillars</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {portalCards.map((card) => {
          const targetUrl = card.targetSlug
            ? withBase(`/en/docs/${card.targetSlug}/`)
            : card.externalUrl!;
          const isExternal = !card.targetSlug;

          return (
            <div class="p-6 sm:p-8 rounded-2xl bg-darkroom-panel border border-darkroom-line flex flex-col justify-between space-y-6 shadow-darkroom-card hover:border-accent/50 transition-all relative group">
              <!-- Top Header -->
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold tracking-wider uppercase text-accent">
                    {card.kicker}
                  </span>
                  <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono border ${card.badgeColor}`}>
                    {card.badge}
                  </span>
                </div>
                
                <h3 class="text-xl sm:text-2xl font-bold font-sans text-text-primary group-hover:text-accent transition-colors">
                  {card.title}
                </h3>
                
                <p class="text-xs sm:text-sm text-text-secondary font-sans leading-relaxed">
                  {card.subtitle}
                </p>
              </div>

              <!-- Highlight Bullets -->
              <div class="p-4 rounded-xl bg-darkroom-canvas border border-darkroom-line space-y-2">
                <div class="text-[10.5px] font-mono text-text-muted uppercase tracking-wider">Technical Highlights</div>
                <ul class="space-y-1.5 text-xs text-text-secondary font-sans">
                  {card.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent shrink-0 mt-0.5 font-mono">›</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Bottom CTA Button -->
              <div>
                <a
                  href={targetUrl}
                  target={isExternal ? '_blank' : '_self'}
                  rel={isExternal ? 'noopener noreferrer' : ''}
                  class="w-full py-2.5 px-4 rounded-xl bg-darkroom-raised hover:bg-accent text-text-primary hover:text-darkroom-canvas font-semibold text-xs transition-all flex items-center justify-center gap-2 group/btn border border-darkroom-line hover:border-accent shadow-sm"
                >
                  <span>{isExternal ? 'View Source & Architecture on GitHub' : 'Start Reading Track'}</span>
                  <svg class="w-3.5 h-3.5 transform group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Bottom Download / Fast Track CTA -->
    <section class="p-8 sm:p-10 rounded-2xl bg-darkroom-panel border border-darkroom-line text-center space-y-4">
      <h3 class="text-2xl font-bold text-text-primary font-sans">Ready to invert your first roll of film?</h3>
      <p class="text-xs sm:text-sm text-text-secondary max-w-xl mx-auto font-sans leading-relaxed">
        Download the native NexFilm Engine build to experience a responsive, physics-grounded negative film grading workbench.
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href={withBase('/en/download/')}
          class="px-6 py-2.5 rounded-xl bg-accent hover:bg-accent-hover text-darkroom-canvas text-xs font-semibold shadow-sm transition-all"
        >
          Download Stable Release
        </a>
        <a
          href={withBase('/en/docs/overview-and-install/')}
          class="px-6 py-2.5 rounded-xl bg-darkroom-raised hover:bg-darkroom-chrome text-text-primary text-xs font-semibold border border-darkroom-line transition-all"
        >
          Start with Chapter 1 →
        </a>
      </div>
    </section>

  </div>

  <DocsSearchModal lang={lang} />
</BaseLayout>
