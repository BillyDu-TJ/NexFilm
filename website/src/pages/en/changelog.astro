---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReleases } from '../../utils/github-releases';
import { withBase } from '../../utils/urls';

const releases = await getReleases();
const latestTag = releases[0]?.tagName || 'v1.1.0';
---

<BaseLayout title="Changelog & Version History · NexFilm Engine" lang="en">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-mono uppercase tracking-widest text-accent block mb-2">Release Timeline</span>
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary tracking-tight font-sans">Version Changelog</h1>
      <p class="text-text-secondary text-sm mt-3">
        Directly synchronized with GitHub Releases, tracking every genuine milestone and optimization of NexFilm Engine.
      </p>
    </div>

    <!-- Timeline Container -->
    <div 
      data-changelog-timeline 
      data-changelog-latest-tag={latestTag}
      class="space-y-12 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-darkroom-line"
    >
      {releases.map((rel, idx) => (
        <div class="relative pl-10 space-y-4" data-release-tag={rel.tagName}>
          <!-- Timeline Marker Pin -->
          <div 
            data-timeline-pin
            class={`absolute left-1.5 top-2 w-4 h-4 rounded-full border-2 border-darkroom-bg flex items-center justify-center ${
              idx === 0 ? 'bg-accent shadow-sm' : 'bg-darkroom-line'
            }`}
          ></div>

          <!-- Release Card -->
          <div class="p-6 sm:p-7 rounded-xl border border-darkroom-line bg-darkroom-panel shadow-darkroom-card space-y-5">
            <!-- Header bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-darkroom-line pb-4">
              <div class="flex items-center gap-3">
                <a 
                  href={rel.htmlUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-2xl font-bold text-text-primary font-mono hover:text-accent transition-colors flex items-center gap-1.5"
                  title="View this release tag on GitHub"
                >
                  <span>{rel.tagName}</span>
                  <svg class="w-4 h-4 opacity-50 hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <span 
                  data-release-badge
                  class={`text-xs px-2.5 py-0.5 rounded-full font-medium font-mono ${
                    idx === 0 
                      ? 'bg-accent-soft text-accent border border-accent/40' 
                      : 'bg-darkroom-canvas text-text-muted border border-darkroom-line'
                  }`}
                >
                  {idx === 0 ? 'Current Stable' : 'Release'}
                </span>
                {rel.isEnFallback && (
                  <span class="text-[10px] text-text-muted font-mono bg-darkroom-canvas px-2 py-0.5 rounded border border-darkroom-line">
                    (Original release notes)
                  </span>
                )}
              </div>
              <span class="text-xs text-text-muted font-mono">{rel.publishedDate}</span>
            </div>

            <!-- Cleaned Body HTML with Darkroom Markdown Typography -->
            <div class="release-markdown space-y-3">
              <Fragment set:html={rel.bodyEnHtml} />
            </div>

            <!-- Assets Expandable Section -->
            {rel.allAssets && rel.allAssets.length > 0 && (
              <details class="pt-4 border-t border-darkroom-line group">
                <summary class="cursor-pointer text-xs font-mono text-text-muted hover:text-accent flex items-center gap-2 select-none">
                  <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-90 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <span>View release packages & SHA-256 hashes ({rel.allAssets.length} assets)</span>
                </summary>
                <div class="mt-3 space-y-2 pl-5 font-mono text-[11px]">
                  {rel.allAssets.map((asset) => (
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 p-2 rounded bg-darkroom-canvas/80 border border-darkroom-line">
                      <div class="flex items-center gap-2 truncate">
                        <svg class="w-3.5 h-3.5 text-text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <a 
                          href={asset.downloadUrl} 
                          download={asset.name}
                          class="text-accent hover:underline truncate font-medium"
                          title="Direct download this asset"
                        >
                          {asset.name}
                        </a>
                        <span class="text-text-muted text-[10px]">({asset.sizeFormatted})</span>
                      </div>
                      {asset.sha256 && (
                        <div class="flex items-center gap-2 text-text-muted">
                          <span class="truncate">SHA: {asset.sha256.slice(0, 10)}...</span>
                          <button
                            type="button"
                            data-copy-sha256
                            data-sha256={asset.sha256}
                            class="text-accent hover:text-accent-hover text-[10px] font-sans transition-colors inline-flex items-center gap-1"
                          >
                            Copy
                          </button>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </details>
            )}

            <!-- Latest Download Link CTA if idx === 0 -->
            {idx === 0 && (
              <div class="pt-2 flex items-center justify-between">
                <a 
                  href={withBase('/en/download/')} 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:text-accent-hover transition-colors"
                >
                  <span>Go to Download page</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
                <a 
                  href={rel.htmlUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-[11px] text-text-muted hover:text-text-secondary transition-colors"
                >
                  GitHub Release Page →
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
