---
import { withBase } from '../utils/urls';
import type { DocChapter } from '../utils/docs';

interface Props {
  prev: DocChapter | null;
  next: DocChapter | null;
  githubSourceUrl: string;
  lang: 'zh' | 'en';
}

const { prev, next, githubSourceUrl, lang } = Astro.props;
---

<div class="mt-16 pt-8 border-t border-darkroom-line space-y-6">
  <!-- Previous / Next Dual Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {prev ? (
      <a
        href={withBase(prev.canonicalPath)}
        class="group p-4 rounded-xl bg-darkroom-panel border border-darkroom-line hover:border-accent/60 transition-all flex flex-col justify-between"
      >
        <span class="text-[10.5px] font-mono uppercase tracking-wider text-text-muted group-hover:text-accent transition-colors flex items-center gap-1.5 mb-1.5">
          <svg class="w-3.5 h-3.5 transform group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>{lang === 'zh' ? '上一章' : 'Previous'}</span>
        </span>
        <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">
          {prev.title}
        </span>
      </a>
    ) : (
      <div></div>
    )}

    {next ? (
      <a
        href={withBase(next.canonicalPath)}
        class="group p-4 rounded-xl bg-darkroom-panel border border-darkroom-line hover:border-accent/60 transition-all flex flex-col justify-between sm:text-right"
      >
        <span class="text-[10.5px] font-mono uppercase tracking-wider text-text-muted group-hover:text-accent transition-colors flex items-center sm:justify-end gap-1.5 mb-1.5">
          <span>{lang === 'zh' ? '下一章' : 'Next'}</span>
          <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
        <span class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">
          {next.title}
        </span>
      </a>
    ) : (
      <div></div>
    )}
  </div>

  <!-- GitHub Source Link & Feedback -->
  <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-text-muted pt-2 font-sans gap-2">
    <a
      href={githubSourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 hover:text-accent transition-colors"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
      <span>{lang === 'zh' ? '在 GitHub 上查看此页源码' : 'View page source on GitHub'}</span>
    </a>
    <span class="font-mono text-[11px] text-text-muted">NexFilm SSOT Handbook v1.1.0</span>
  </div>
</div>
